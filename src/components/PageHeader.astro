---
// Dark title band used at the top of inner pages (Archive, About, articles).
interface Props {
	label?: string;
	title: string;
	subtitle?: string;
}
const { label, title, subtitle } = Astro.props;
---

<section class="relative overflow-hidden bg-brand-ink text-white">
	<div
		class="pointer-events-none absolute inset-0 opacity-60"
		style="background: radial-gradient(50% 90% at 85% 20%, hsl(182 60% 22% / .5), transparent 70%);"
		aria-hidden="true"
	>
	</div>
	<div class="relative mx-auto max-w-4xl px-4 py-14 sm:px-6 md:py-20">
		{label && <p class="label !mb-4 text-brand-teal-light">{label}</p>}
		<h1 class="!mb-4 font-display !text-5xl font-medium uppercase !leading-[0.95] tracking-[-1px] !text-white md:!text-6xl">
			{title}
		</h1>
		{subtitle && <p class="!m-0 max-w-2xl text-[17px] leading-relaxed text-white/65">{subtitle}</p>}
		<slot />
	</div>
</section>
