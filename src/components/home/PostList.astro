---
// Bordered list of posts with thumbnails, used for "Most Liked" and "You might also like".
//   meta="likes" → ♥ 83 LIKES      meta="views" → MAR 28, 2026 · 523 VIEWS
// Counts are built in, then refreshed live from the API (liveStats.ts).
import PostImage from '../PostImage.astro';
import { formatDate, type Post } from '../../lib/posts';
import { getAllStats } from '../../lib/stats';

interface Props {
	title: string;
	icon: 'heart' | 'sparkle';
	posts: Post[];
	meta: 'likes' | 'views';
}
const { title, icon, posts, meta } = Astro.props;
const stats = await getAllStats();
const count = (p: Post) => stats[p.id]?.[meta] ?? 0;
---

{
	posts.length > 0 && (
		<section class="min-w-0">
			<div class="mb-5 flex items-center gap-3">
				{icon === 'heart' && <span class="h-4 w-[3px] bg-primary" aria-hidden="true" />}
				{icon === 'heart' ? (
					<svg class="h-5 w-5 text-red-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 8 3.6 4.5 7.1 4.5c2 0 3.6 1.1 4.9 2.8 1.3-1.7 2.9-2.8 4.9-2.8 3.5 0 5.7 3.5 4.4 6.8-1.8 4.6-9.3 9.2-9.3 9.2z" />
					</svg>
				) : (
					<svg class="h-5 w-5 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
						<path d="M10 3.5 11.8 8.2 16.5 10 11.8 11.8 10 16.5 8.2 11.8 3.5 10 8.2 8.2z" />
						<path d="M18 2v4M16 4h4M5 18v3M3.5 19.5h3" />
					</svg>
				)}
				<h2 class="label !m-0 !text-[16px] !font-medium tracking-[0.1em] text-foreground">{title}</h2>
				<span class="h-px flex-1 bg-border" aria-hidden="true" />
			</div>

			<div class="border border-border">
				{posts.map((p) => (
					<a href={`/blog/${p.id}/`} class="group flex items-center gap-4 border-b border-border p-4 !text-foreground no-underline transition-colors last:border-b-0 hover:bg-muted">
						<PostImage fallback={p.data.category ?? ''} src={p.data.heroImage} alt="" width={200} class="h-14 w-16 shrink-0 !rounded-none object-cover" />
						<div class="min-w-0">
							<p class="!mb-0.5 font-display text-[16px] font-semibold uppercase tracking-[0.1em] text-primary">{p.data.category}</p>
							<p class="!mb-1 font-heading text-[16px] leading-snug transition-colors group-hover:text-primary">{p.data.title}</p>
							<p class="!m-0 flex items-center gap-1.5 text-[16px] uppercase tracking-[0.05em] text-muted-foreground">
								{meta === 'likes' ? (
									<>
										<svg class="h-3 w-3 text-red-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
											<path d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 8 3.6 4.5 7.1 4.5c2 0 3.6 1.1 4.9 2.8 1.3-1.7 2.9-2.8 4.9-2.8 3.5 0 5.7 3.5 4.4 6.8-1.8 4.6-9.3 9.2-9.3 9.2z" />
										</svg>
										<span data-live="likes" data-slug={p.id}>{count(p).toLocaleString()}</span> likes
									</>
								) : (
									<span>
										{formatDate(p.data.pubDate)} · <span data-live="views" data-slug={p.id}>{count(p).toLocaleString()}</span> views
									</span>
								)}
							</p>
						</div>
					</a>
				))}
			</div>
		</section>
	)
}
