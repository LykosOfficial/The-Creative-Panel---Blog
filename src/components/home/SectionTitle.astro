---
// Magazine section heading: teal bar, small tracked label, hairline rule.
// <SectionTitle>Featured</SectionTitle>
interface Props {
	/** Right-column size (10px) */
	small?: boolean;
}
const { small = false } = Astro.props;
---

<div class="mb-5 flex items-center gap-3">
	<span class="h-4 w-[3px] bg-primary" aria-hidden="true"></span>
	<h2 class:list={['label !m-0 !font-medium tracking-[0.1em] text-foreground', small ? '!text-[10px]' : '!text-[16px]']}>
		<slot />
	</h2>
	<span class="h-px flex-1 bg-border" aria-hidden="true"></span>
</div>
