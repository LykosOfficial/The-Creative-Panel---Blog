---
// Right sidebar: About card. Content comes from src/data/profile.ts
import SectionTitle from './SectionTitle.astro';
import { profile } from '../../data/profile';

// Simple line icons (24×24, stroke = currentColor)
const icons: Record<string, string> = {
	x: 'M22 4.5s-.9 2-2.4 3c.5 9.5-10.3 14.9-17.1 9.6 2.6.2 4.6-.6 6.1-2-4.6-.4-6.1-4.6-5.3-7.4.9.6 1.9.9 2.6.9C3.6 6.9 3.9 3.6 5.4 2.9 7.6 5.6 10.6 7.2 13.9 7.3 13.3 4 16.3 1.8 19 3.3c1 .2 2-.3 3-.8z',
	instagram: 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm5 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm5.5-1.5h.01',
	goodreads: 'M12 6.5C10 5 7 4.5 3 5v13c4-.5 7 0 9 1.5 2-1.5 5-2 9-1.5V5c-4-.5-7 0-9 1.5zm0 0v13',
	threads: 'M16.5 11.5c-.5-3-2.5-4.5-5-4.5-3 0-5 2.2-5 5.5S8.5 18 12 18c3 0 5-1.6 5-4 0-2.5-2.5-3.5-5-3.5-2 0-3 1-3 2.2 0 1.3 1.2 2 2.5 2 2.5 0 3.5-2 3.5-5',
	bluesky: 'M12 11c-1.5-3-5.5-7-8-7-1 0-1 1.5-1 3s.5 4 3.5 4.5C4 12 3.5 14 5.5 15.5 8 17.5 10.5 15 12 12c1.5 3 4 5.5 6.5 3.5 2-1.5 1.5-3.5-1-4C20.5 11 21 8.5 21 7s0-3-1-3c-2.5 0-6.5 4-8 7z',
	tiktok: 'M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.5 2.5 2.5 4.5 5 4.5',
	youtube: 'M3 8.5C3 6.5 4.5 5 6.5 5h11C19.5 5 21 6.5 21 8.5v7c0 2-1.5 3.5-3.5 3.5h-11C4.5 19 3 17.5 3 15.5zM10 9v6l5-3z',
};
const initials = profile.name.split(' ').map((w) => w[0]).join('').slice(0, 2);
---

<div>
	<SectionTitle>About</SectionTitle>
	<div class="border border-border bg-card p-5">
		{
			profile.avatar ? (
				<img src={profile.avatar} alt={profile.name} class="mb-4 h-[72px] w-[72px] border border-border object-cover" />
			) : (
				<div class="mb-4 flex h-[72px] w-[72px] items-center justify-center border border-border bg-muted font-display text-[20px] font-semibold text-muted-foreground/50" aria-hidden="true">
					{initials}
				</div>
			)
		}
		<p class="!mb-0.5 font-display text-[14px] font-semibold uppercase leading-tight tracking-[-0.2px]">{profile.name}</p>
		<p class="!mb-3 text-[10px] uppercase tracking-[0.1em] text-muted-foreground">{profile.role}</p>
		<p class="!mb-3 text-[12px] leading-relaxed text-muted-foreground">{profile.bio}</p>

		{
			profile.socials.length > 0 && (
				<div class="mb-4 flex items-center gap-4">
					{profile.socials.map((s) => (
						<a href={s.url} target="_blank" rel="noopener me" aria-label={s.label} class="!text-muted-foreground hover:!text-primary">
							<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d={icons[s.icon]} />
							</svg>
						</a>
					))}
				</div>
			)
		}

		<a href="/about" class="label !text-[10px] font-semibold">Full bio →</a>
	</div>
</div>
