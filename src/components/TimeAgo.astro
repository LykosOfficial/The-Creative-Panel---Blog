---
// "3 days ago"-style time. The page is built ahead of time, so the relative text is filled in
// by the reader's browser (and kept fresh every minute). Without JavaScript it shows the date.
// Hovering shows the exact date and time.
import { SITE_TIMEZONE } from '../consts';
import { formatDate } from '../lib/posts';

interface Props {
	date: Date;
	/** Text before the time, e.g. "Posted" → "Posted 3 days ago" */
	prefix?: string;
	class?: string;
}

const { date, prefix, class: className } = Astro.props;
const exact = date.toLocaleString('en-US', {
	month: 'long',
	day: 'numeric',
	year: 'numeric',
	hour: 'numeric',
	minute: '2-digit',
	timeZone: SITE_TIMEZONE,
	timeZoneName: 'short',
});
---

<span class={className}>
	{prefix && `${prefix} `}<time datetime={date.toISOString()} title={exact} data-time-ago>{formatDate(date)}</time>
</span>

<script>
	const units: [Intl.RelativeTimeFormatUnit, number][] = [
		['year', 365 * 24 * 3600],
		['month', 30 * 24 * 3600],
		['week', 7 * 24 * 3600],
		['day', 24 * 3600],
		['hour', 3600],
		['minute', 60],
	];
	const rtf = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });

	/** "just now", "5 minutes ago", "yesterday", "3 weeks ago", "last year"… */
	function timeAgo(iso: string) {
		const seconds = (new Date(iso).getTime() - Date.now()) / 1000;
		if (Math.abs(seconds) < 60) return 'just now';
		for (const [unit, size] of units) {
			if (Math.abs(seconds) >= size) return rtf.format(Math.round(seconds / size), unit);
		}
		return 'just now';
	}

	function update() {
		document.querySelectorAll<HTMLTimeElement>('time[data-time-ago]').forEach((el) => {
			el.textContent = timeAgo(el.dateTime);
		});
	}
	update();
	setInterval(update, 60_000);
	document.addEventListener('astro:page-load', update);
</script>
