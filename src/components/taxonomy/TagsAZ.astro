---
// Tags index design A, "Book index": tags grouped A–Z with a letter bar to jump around,
// like the index at the back of a book. Stays tidy at 10 tags or 200.
import type { Term } from '../../lib/taxonomy';

interface Props {
	terms: Term[];
	base: string; // "/tags/"
	prefix?: string; // "#"
}
const { terms, base, prefix = '' } = Astro.props;
const groups = new Map<string, Term[]>();
for (const t of [...terms].sort((a, b) => a.label.localeCompare(b.label))) {
	const letter = /[a-z]/i.test(t.label[0]) ? t.label[0].toUpperCase() : '#';
	groups.set(letter, [...(groups.get(letter) ?? []), t]);
}
const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
---

<nav aria-label="Jump to letter" class="sticky top-[64px] z-10 -mx-4 mb-8 flex flex-wrap gap-x-1 border-b border-border bg-background/95 px-4 py-3 backdrop-blur">
	{
		letters.map((l) =>
			groups.has(l) ? (
				<a href={`#letter-${l}`} class="w-7 text-center font-display text-[15px] font-semibold !text-foreground no-underline hover:!text-primary">
					{l}
				</a>
			) : (
				<span class="w-7 text-center font-display text-[15px] text-muted-foreground/40" aria-hidden="true">
					{l}
				</span>
			),
		)
	}
</nav>

<div class="grid gap-x-12 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
	{
		[...groups.entries()].map(([letter, list]) => (
			<section id={`letter-${letter}`} class="scroll-mt-32">
				<h2 class="!mb-3 border-b-2 border-brand-gold pb-1 font-display !text-[40px] font-semibold !leading-none text-brand-gold">{letter}</h2>
				<ul class="!m-0 !p-0" role="list">
					{list.map((t) => (
						<li class="list-none">
							<a href={`${base}${t.slug}/`} class="group flex items-baseline justify-between gap-3 py-1.5 !text-foreground no-underline">
								<span class="text-[16px] transition-colors group-hover:text-primary">
									{prefix}
									{t.label}
								</span>
								<span class="border-b border-dotted border-border flex-1 translate-y-[-4px]" aria-hidden="true" />
								<span class="text-[13px] tabular-nums text-muted-foreground">{t.posts.length}</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		))
	}
</div>
