---
// Category and tag pages, "Section front" (like Electric Literature's sections):
// the big title (TermHeader), then a lead story with three stacked beside it, then a card grid.
import PostImage from '../PostImage.astro';
import Pagination from '../Pagination.astro';
import TermHeader from './TermHeader.astro';
import { formatDate, readingTime, type Post } from '../../lib/posts';
import { termLabel } from '../../lib/taxonomy';

interface Props {
	label: string;
	kicker: string;
	description?: string;
	count: number;
	siblings?: { label: string; href: string; current?: boolean }[];
	posts: Post[];
	page: { current: number; total: number; base: string };
}
const { label, kicker, description, count, siblings = [], posts, page } = Astro.props;
// Lead + sidebar only on page 1; later pages are just the grid
const lead = page.current === 1 ? posts[0] : undefined;
const side = page.current === 1 ? posts.slice(1, 4) : [];
const grid = page.current === 1 ? posts.slice(4) : posts;
---

<TermHeader {label} {kicker} {description} {count} {siblings} {page} />


<main class="page-wide py-12">
	{
		lead && (
			<div class:list={['mb-12 grid gap-8', side.length > 0 ? 'lg:grid-cols-[minmax(0,1.7fr)_minmax(0,1fr)]' : 'max-w-4xl']}>
				<a href={`/blog/${lead.id}/`} class="group block !text-foreground no-underline">
					<div class="aspect-[16/9] overflow-hidden bg-brand-ink">
						<PostImage fallback={lead.data.category ?? ''} src={lead.data.heroImage} alt="" width={1100} class="h-full w-full !rounded-none object-cover transition duration-500 group-hover:scale-[1.03]" />
					</div>
					<p class="label !mb-2 mt-5 !text-[16px] text-primary">{termLabel(lead.data.category ?? '')}</p>
					<h2 class="!mb-3 font-display !text-[34px] font-semibold uppercase !leading-[1.02] tracking-[-0.5px] transition-colors group-hover:text-primary md:!text-[42px]">
						{lead.data.title}
					</h2>
					<p class="!mb-3 max-w-2xl text-[16px] leading-relaxed text-muted-foreground">{lead.data.description}</p>
					<p class="label !m-0 !text-[16px] text-muted-foreground">
						{formatDate(lead.data.pubDate)} · {readingTime(lead)} min read
					</p>
				</a>
				<ul class="!m-0 flex flex-col gap-6 !p-0" role="list">
					{side.map((p) => (
						<li class="list-none border-b border-border pb-6 last:border-b-0">
							<a href={`/blog/${p.id}/`} class="group flex gap-4 !text-foreground no-underline">
								<div class="aspect-[4/3] w-32 shrink-0 overflow-hidden bg-muted">
									<PostImage fallback={p.data.category ?? ''} src={p.data.heroImage} alt="" width={300} class="h-full w-full !rounded-none object-cover" />
								</div>
								<div class="min-w-0">
									<p class="label !mb-1 !text-[16px] text-primary">{termLabel(p.data.category ?? '')}</p>
									<h3 class="!mb-1.5 font-display !text-[20px] font-semibold uppercase !leading-[1.05] transition-colors group-hover:text-primary">{p.data.title}</h3>
									<p class="label !m-0 !text-[16px] text-muted-foreground">{formatDate(p.data.pubDate)}</p>
								</div>
							</a>
						</li>
					))}
				</ul>
			</div>
		)
	}

	{
		grid.length > 0 && (
			<ul class="!m-0 grid gap-x-8 gap-y-12 border-t border-border !p-0 pt-12 sm:grid-cols-2 lg:grid-cols-3" role="list">
				{grid.map((p) => (
					<li class="list-none">
						<a href={`/blog/${p.id}/`} class="group block !text-foreground no-underline">
							<div class="aspect-[3/2] overflow-hidden bg-muted">
								<PostImage fallback={p.data.category ?? ''} src={p.data.heroImage} alt="" width={600} class="h-full w-full !rounded-none object-cover transition duration-500 group-hover:scale-[1.03]" />
							</div>
							<p class="label !mb-1.5 mt-4 !text-[16px] text-primary">{termLabel(p.data.category ?? '')}</p>
							<h3 class="!mb-2 font-display !text-[24px] font-semibold uppercase !leading-[1.05] transition-colors group-hover:text-primary">{p.data.title}</h3>
							<p class="!mb-2 text-[16px] leading-relaxed text-muted-foreground">{p.data.description}</p>
							<p class="label !m-0 !text-[16px] text-muted-foreground">{formatDate(p.data.pubDate)} · {readingTime(p)} min read</p>
						</a>
					</li>
				))}
			</ul>
		)
	}

	<Pagination {...page} />
</main>
