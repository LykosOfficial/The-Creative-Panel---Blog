---
// Category design B, "Stream" (like The Verge's topic pages):
// an oversized title across the page, then one column of stories, newest first,
// each with date/section on the left and the image on the right.
import PostImage from '../PostImage.astro';
import Pagination from '../Pagination.astro';
import TermHeader from './TermHeader.astro';
import { formatDate, readingTime, type Post } from '../../lib/posts';
import { termLabel } from '../../lib/taxonomy';

interface Props {
	label: string;
	kicker: string;
	description?: string;
	count: number;
	siblings?: { label: string; href: string; current?: boolean }[];
	posts: Post[];
	page: { current: number; total: number; base: string };
}
const { label, kicker, description, count, siblings = [], posts, page } = Astro.props;
---

<TermHeader {label} {kicker} {description} {count} {siblings} {page} />

<main class="page-narrow py-6">
	<ul class="!m-0 !p-0" role="list">
		{
			posts.map((p) => (
				<li class="list-none border-b border-border">
					<a href={`/blog/${p.id}/`} class="group grid grid-cols-[minmax(0,1fr)_96px] items-start gap-5 py-8 !text-foreground no-underline sm:grid-cols-[120px_minmax(0,1fr)_200px] sm:gap-8">
						<div class="hidden sm:block">
							<p class="label !mb-1 !text-[12px] text-primary">{termLabel(p.data.category ?? '')}</p>
							<p class="label !m-0 !text-[11px] text-muted-foreground">{formatDate(p.data.pubDate)}</p>
						</div>
						<div class="min-w-0">
							<p class="label !mb-1.5 !text-[11px] text-primary sm:hidden">
								{termLabel(p.data.category ?? '')} · {formatDate(p.data.pubDate)}
							</p>
							<h2 class="!mb-2 font-display !text-[26px] font-semibold uppercase !leading-[1.02] tracking-[-0.3px] transition-colors group-hover:text-primary sm:!text-[30px]">
								{p.data.title}
							</h2>
							<p class="!mb-2 hidden text-[15px] leading-relaxed text-muted-foreground sm:block">{p.data.description}</p>
							<p class="label !m-0 !text-[11px] text-muted-foreground">{readingTime(p)} min read</p>
						</div>
						<div class="aspect-square overflow-hidden bg-muted sm:aspect-[4/3]">
							{p.data.heroImage && <PostImage src={p.data.heroImage} alt="" width={400} class="h-full w-full !rounded-none object-cover grayscale transition duration-300 group-hover:grayscale-0" />}
						</div>
					</a>
				</li>
			))
		}
	</ul>
	<Pagination {...page} />
</main>
