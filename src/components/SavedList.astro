---
// "Saved" page content: every post saved on this device, newest first, each with Remove.
// Saved posts live in the reader's browser (localStorage), so the list is filled in by the browser.
import TermHeader from './taxonomy/TermHeader.astro';
---

<TermHeader
	label="Saved"
	kicker="Read later"
	description="Posts you've saved, newest first. They're kept in this browser, so they only show on this device."
	count={0}
	meta=" "
/>
<main class="page-narrow py-10">
	<p class="!mb-3 text-[12px] uppercase tracking-[0.1em] text-muted-foreground" data-saved-count>Loading…</p>
	<ul class="!m-0 border border-border !p-0" role="list" data-saved-list hidden></ul>
	<p class="text-[15px] leading-relaxed text-muted-foreground" data-saved-empty hidden>
		Nothing saved yet. Tap the bookmark on any post to keep it here for later. <a href="/blog/">Browse the archive →</a>
	</p>
</main>

<script>
	import { loadSavedPosts, onSavedChange, unsave } from '../lib/saved';

	const list = document.querySelector<HTMLUListElement>('[data-saved-list]');
	if (list) {
		const count = document.querySelector<HTMLElement>('[data-saved-count]')!;
		const empty = document.querySelector<HTMLElement>('[data-saved-empty]')!;
		const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
		const render = async () => {
			const posts = await loadSavedPosts();
			count.textContent = `${posts.length} saved ${posts.length === 1 ? 'post' : 'posts'} · on this device`;
			list.hidden = posts.length === 0;
			empty.hidden = posts.length > 0;
			list.innerHTML = posts
				.map(
					(p) => `<li class="flex list-none items-center gap-4 border-b border-border p-5 last:border-b-0">
						<a href="${esc(p.url)}" class="group min-w-0 flex-1 !text-foreground no-underline">
							<p class="label !mb-1 !text-[11px] text-primary">${esc(p.category)}</p>
							<p class="!mb-1 font-display text-[22px] font-semibold uppercase leading-tight group-hover:text-primary">${esc(p.title)}</p>
							<p class="label !m-0 !text-[11px] text-muted-foreground">${esc(p.date)}</p>
						</a>
						<button type="button" data-unsave="${esc(p.id)}" class="label shrink-0 border border-border px-3 py-1.5 !text-[11px] text-muted-foreground hover:border-primary hover:text-primary">Remove</button>
					</li>`,
				)
				.join('');
		};
		list.addEventListener('click', (e) => {
			const id = (e.target as HTMLElement).closest<HTMLElement>('[data-unsave]')?.dataset.unsave;
			if (id) unsave(id);
		});
		render();
		onSavedChange(render);
	}
</script>
