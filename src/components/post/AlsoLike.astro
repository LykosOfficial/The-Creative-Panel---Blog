---
// "You might also like": a bordered list with thumbnails.
import PostImage from '../PostImage.astro';
import { formatDate, readingTime, type Post } from '../../lib/posts';

interface Props {
	posts: Post[];
}
const { posts } = Astro.props;
---

{
	posts.length > 0 && (
		<section class="mt-10">
			<div class="mb-5 flex items-center gap-3">
				<!-- sparkle icon -->
				<svg class="h-5 w-5 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
					<path d="M10 3.5 11.8 8.2 16.5 10 11.8 11.8 10 16.5 8.2 11.8 3.5 10 8.2 8.2z" />
					<path d="M18 2v4M16 4h4M5 18v3M3.5 19.5h3" />
				</svg>
				<h2 class="label !m-0 !text-[14px] !font-medium tracking-[0.1em] text-foreground">You might also like</h2>
				<span class="h-px flex-1 bg-border" aria-hidden="true" />
			</div>

			<div class="border border-border">
				{posts.map((p) => (
					<a href={`/blog/${p.id}/`} class="group flex items-center gap-6 border-b border-border px-6 py-5 !text-foreground no-underline transition-colors last:border-b-0 hover:bg-muted">
						{p.data.heroImage && (
							<PostImage src={p.data.heroImage} alt="" width={200} class="h-[84px] w-24 shrink-0 !rounded-none object-cover" />
						)}
						<div class="min-w-0">
							<p class="!mb-1 font-display text-[13px] font-semibold uppercase tracking-[0.1em] text-primary">{p.data.category}</p>
							<p class="!mb-1 font-heading text-[18px] leading-snug transition-colors group-hover:text-primary">{p.data.title}</p>
							<p class="label !m-0 text-[13px] tracking-[0.06em] text-muted-foreground">
								{formatDate(p.data.pubDate)} · {readingTime(p)} min read
							</p>
						</div>
					</a>
				))}
			</div>
		</section>
	)
}
