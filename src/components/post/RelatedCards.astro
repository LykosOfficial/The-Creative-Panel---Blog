---
// "Related": a row of image cards. On desktop the hovered card widens and shows
// "Read →"; on phones the row scrolls sideways.
import PostImage from '../PostImage.astro';
import SectionTitle from '../home/SectionTitle.astro';
import { formatDate, type Post } from '../../lib/posts';

interface Props {
	posts: Post[];
}
const { posts } = Astro.props;
---

{
	posts.length > 0 && (
		<section class="mt-14">
			<SectionTitle>Related</SectionTitle>
			<div class="related-row -mx-4 flex snap-x snap-mandatory scroll-px-4 gap-2 overflow-x-auto px-4 pb-2 sm:mx-0 sm:px-0 md:overflow-visible md:pb-0">
				{posts.map((p) => (
					<a href={`/blog/${p.id}/`} class="rcard group relative block h-[180px] shrink-0 snap-start overflow-hidden bg-brand-ink !text-white no-underline">
						{p.data.heroImage && (
							<PostImage src={p.data.heroImage} alt="" width={800} class="absolute inset-0 h-full w-full !rounded-none object-cover transition duration-500 group-hover:scale-105" />
						)}
						<div class="absolute inset-0 bg-gradient-to-b from-black/55 via-black/20 to-black/75" />
						<div class="absolute inset-0 flex flex-col p-4">
							<h3 class="rcard-title !m-0 font-display !text-[17px] font-semibold uppercase !leading-[1.15] text-white">{p.data.title}</h3>
							<div class="mt-auto">
								<p class="!mb-1 font-display text-[12px] font-bold uppercase tracking-[0.1em] text-white">{p.data.category}</p>
								<p class="label !m-0 text-[13px] tracking-[0.06em] text-white/75">{formatDate(p.data.pubDate)}</p>
								<p class="rcard-read label !m-0 mt-2 text-[11px] font-semibold text-white/70">Read →</p>
							</div>
						</div>
					</a>
				))}
			</div>
		</section>
	)
}

<style>
	/* Phones: fixed-width cards you swipe through */
	.rcard {
		width: 72%;
	}
	.rcard-title {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.rcard-read {
		display: none;
	}
	.related-row {
		scrollbar-width: none;
	}

	/* Desktop: equal cards; the hovered one grows to 3x and shows "Read →" */
	@media (min-width: 768px) {
		.rcard {
			width: auto;
			flex: 1 1 0;
			transition: flex-grow 0.45s ease;
		}
		.rcard:hover,
		.rcard:focus-visible {
			flex-grow: 3;
		}
		.rcard:hover .rcard-title,
		.rcard:focus-visible .rcard-title {
			-webkit-line-clamp: 1;
			color: var(--color-brand-teal-light);
		}
		.rcard:hover .rcard-read,
		.rcard:focus-visible .rcard-read {
			display: block;
		}
	}
</style>
