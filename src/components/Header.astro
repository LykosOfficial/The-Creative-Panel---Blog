---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import HeaderLink from './HeaderLink.astro';
import PanelMenu, { type PanelLink } from './PanelMenu';

// Nav: Latest · The Panel ▾ · Books · Sites · About
// "The Panel" groups the ways to browse the blog. Full links show from 1180px; below that, the ☰ menu.
const PANEL_LABEL = 'The Panel';
const panel: PanelLink[] = [
	{ href: '/blog', label: 'Archive', description: 'Every post, newest first' },
	{ href: '/trending', label: 'Trending', description: 'Most read and most liked' },
	{ href: '/categories', label: 'Categories', description: 'Browse by section' },
	{ href: '/tags', label: 'Tags', description: 'Browse by topic' },
];
const before = [{ href: '/', label: 'Latest' }];
const after = [
	{ href: '/books', label: 'Books' },
	{ href: '/sites', label: 'Sites' },
	{ href: '/about', label: 'About' },
];
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!-- Solid black at the top; turns to frosted glass once you scroll (.scrolled, set below) -->
<header class="site-header sticky top-0 z-50 border-b border-white/10 bg-black text-white transition-all duration-300">
	<nav class="mx-auto flex h-[56px] max-w-7xl items-center justify-between gap-6 px-4 sm:px-6" aria-label="Main">
		<!-- Brand logo: same font/style as joelgreenauthor.com (Geist, bold, uppercase, tight; gold title, teal accents) -->
		<a href="/" class="brand flex min-w-0 items-baseline whitespace-nowrap font-logo font-bold uppercase leading-none tracking-tight">
			<span class="text-brand-gold text-[22px] sm:text-[26px]">{SITE_TITLE}</span>
			<!-- Tagline is hidden on phones: "The Creative Panel" only -->
			<span class="hidden sm:inline text-brand-logo-accent mx-2">—</span>
			<span class="hidden sm:inline text-[15px]">{SITE_DESCRIPTION}</span>
			<span class="text-brand-logo-accent text-[22px] sm:text-[26px]">.</span>
		</a>

		<div class="flex items-center gap-1">
			<!-- Desktop links -->
			<div class="nav-links mr-2 hidden items-center min-[1180px]:flex xl:mr-3 xl:gap-1">
				{before.map((l) => <HeaderLink href={l.href}>{l.label}</HeaderLink>)}
				<PanelMenu client:idle label={PANEL_LABEL} links={panel} pathname={pathname} />
				{after.map((l) => <HeaderLink href={l.href}>{l.label}</HeaderLink>)}
			</div>

			<button type="button" class="icon-btn inline-flex" data-open-search aria-label="Search">
				<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
					><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg
				>
			</button>
			<button type="button" class="icon-btn inline-flex" data-theme-toggle aria-label="Toggle dark mode">
				<!-- moon (shown in light mode) -->
				<svg viewBox="0 0 24 24" class="h-4 w-4 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
					><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg
				>
				<!-- sun (shown in dark mode) -->
				<svg viewBox="0 0 24 24" class="hidden h-4 w-4 dark:block" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
					><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg
				>
			</button>
			<button type="button" class="icon-btn inline-flex min-[1180px]:hidden" data-menu-toggle aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
				<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
					><path d="M4 7h16M4 12h16M4 17h16"></path></svg
				>
			</button>
		</div>
	</nav>

	<!-- Phone / tablet / small-laptop menu (below 1180px) -->
	<div id="mobile-menu" class="mobile-menu hidden border-t border-white/10 min-[1180px]:hidden">
		<div class="mx-auto flex max-w-7xl flex-col px-4 py-2 sm:px-6">
			{before.map((l) => <HeaderLink href={l.href}>{l.label}</HeaderLink>)}
			<p class="mobile-group !mb-0 mt-3 pb-1 text-[11px] uppercase tracking-[2px] text-brand-logo-accent">{PANEL_LABEL}</p>
			{panel.map((l) => <HeaderLink href={l.href} class="pl-3">{l.label}</HeaderLink>)}
			{after.map((l) => <HeaderLink href={l.href}>{l.label}</HeaderLink>)}
		</div>
	</div>
</header>

<!-- Search dialog. <dialog> gives us focus trapping + Esc-to-close for free. -->
<dialog class="search-dialog" aria-label="Search posts">
	<div class="border-b border-border p-4">
		<input type="search" placeholder="Search posts…" class="w-full bg-transparent text-lg outline-none" autocomplete="off" />
	</div>
	<ul class="search-results !m-0 max-h-[60vh] overflow-y-auto !p-0" role="list"></ul>
	<p class="search-empty label !m-0 hidden p-5 text-[12px] text-muted-foreground">No matches.</p>
</dialog>

<script>
	// --- Glass header: add .scrolled after the first few pixels of scrolling
	const header = document.querySelector<HTMLElement>(".site-header");
	const onScroll = () => header?.classList.toggle("scrolled", scrollY > 8);
	addEventListener("scroll", onScroll, { passive: true });
	onScroll();

	// --- Dark mode: the class is applied early in BaseHead; this just toggles + remembers it
	document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
		const dark = document.documentElement.classList.toggle('dark');
		localStorage.setItem('theme', dark ? 'dark' : 'light');
	});

	// --- Mobile menu
	const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const menu = document.getElementById('mobile-menu');
	menuBtn?.addEventListener('click', () => {
		const open = menu?.classList.toggle('hidden') === false;
		menuBtn.setAttribute('aria-expanded', String(open));
	});

	// --- Search: loads /search.json (built at build time) the first time it's opened
	type Entry = { title: string; description: string; url: string; category: string; tags: string[]; date: string };
	const dialog = document.querySelector<HTMLDialogElement>('.search-dialog')!;
	const input = dialog.querySelector('input')!;
	const results = dialog.querySelector('.search-results')!;
	const empty = dialog.querySelector('.search-empty')!;
	let index: Entry[] | null = null;

	const render = (q: string) => {
		const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
		const hits =
			!index || !terms.length
				? []
				: index.filter((e) => {
						const hay = `${e.title} ${e.description} ${e.category} ${e.tags.join(' ')}`.toLowerCase();
						return terms.every((t) => hay.includes(t));
					});
		results.innerHTML = '';
		for (const e of hits.slice(0, 8)) {
			const li = document.createElement('li');
			li.className = 'list-none border-b border-border';
			const a = document.createElement('a');
			a.href = e.url;
			a.className = 'block px-5 py-3 no-underline hover:bg-muted';
			const meta = document.createElement('span');
			meta.className = 'label block text-[11px] text-primary';
			meta.textContent = `${e.category} · ${e.date}`;
			const title = document.createElement('span');
			title.className = 'block font-heading text-[17px] text-foreground';
			title.textContent = e.title;
			a.append(meta, title);
			li.append(a);
			results.append(li);
		}
		empty.classList.toggle('hidden', !terms.length || hits.length > 0);
	};

	const openSearch = async () => {
		dialog.showModal();
		input.focus();
		index ??= await fetch('/search.json').then((r) => r.json());
		render(input.value);
	};
	document.querySelector('[data-open-search]')?.addEventListener('click', openSearch);
	input.addEventListener('input', () => render(input.value));
	// Click on the dark backdrop closes it
	dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
	// "/" opens search from anywhere (like many sites)
	addEventListener('keydown', (e) => {
		if (e.key === '/' && !(e.target as HTMLElement).closest('input, textarea')) {
			e.preventDefault();
			openSearch();
		}
	});
</script>

<style>
	.site-header.scrolled {
		background-color: rgb(0 0 0 / 0.7);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
	}
	/* Keep the open phone menu readable over busy content */
	.site-header.scrolled .mobile-menu {
		background-color: rgb(0 0 0 / 0.6);
	}
	.brand,
	.brand:hover {
		color: white;
		text-decoration: none;
	}
	/* display is set with Tailwind classes so xl:hidden can override it */
	.icon-btn {
		height: 2.25rem;
		width: 2.25rem;
		align-items: center;
		justify-content: center;
		color: rgb(255 255 255 / 0.6);
		cursor: pointer;
		transition: color 0.15s;
	}
	.icon-btn:hover {
		color: white;
	}
	/* Nav links: Barlow, 12px, uppercase, wide tracking (matches prototype) */
	header :global(a.nav-link) {
		font-family: var(--font-heading);
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 1.2px;
		padding: 0.5rem 0.55rem;
		color: rgb(255 255 255 / 0.7);
		border-bottom: 2px solid transparent;
		text-decoration: none;
	}
	header :global(a.nav-link:hover) {
		color: white;
	}
	header :global(a.nav-link.active) {
		color: var(--color-brand-teal-light);
		border-bottom-color: var(--color-brand-teal-light);
	}
	.mobile-menu :global(a.nav-link) {
		padding: 0.85rem 0;
		border-bottom: 1px solid rgb(255 255 255 / 0.08);
	}
	.mobile-menu :global(a.nav-link.active) {
		border-bottom-color: rgb(255 255 255 / 0.08);
	}

	.search-dialog {
		width: min(640px, calc(100% - 2rem));
		margin: 12vh auto auto;
		padding: 0;
		border: 1px solid var(--border);
		background: var(--card);
		color: var(--foreground);
	}
	.search-dialog::backdrop {
		background: rgb(0 0 0 / 0.6);
	}
</style>
