---
// Design lab: try layouts with real + sample posts before choosing one.
// Only built when PUBLIC_LAB=true (local preview); the live site never has these pages.
//   PUBLIC_LAB=true astro build && astro preview  →  http://localhost:4331/lab/
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import SectionFront from '../../components/taxonomy/SectionFront.astro';
import SavedList from '../../components/SavedList.astro';
import { CATEGORY_BLURBS, SAMPLE_SECTIONS, labPosts } from '../../lib/labSamples';
import { paginate } from '../../lib/pagination';
import { DESIGNS, type Design } from '../../lib/labDesigns';
import { categoryIndex } from '../../lib/taxonomy';


export async function getStaticPaths() {
	if (process.env.PUBLIC_LAB !== 'true' && import.meta.env.PUBLIC_LAB !== 'true') return [];
	return [{ params: { slug: undefined }, props: {} }, ...(Object.keys(DESIGNS) as Design[]).map((design) => ({ params: { slug: design }, props: { design } }))];
}

const { design } = Astro.props as { design?: Design };
const posts = labPosts(await getCollection('blog'));
const categories = categoryIndex(posts);

// The navbar designs show a category page underneath, using every sample post as one section
const base = design ? `/lab/${design}/` : '/lab/';
const pages = paginate(posts, base);
const current = pages[0];
const siblings = [
	{ label: 'Writing', href: base, current: true },
	...categories.filter((c) => c.slug !== 'writing').map((c) => ({ label: c.label, href: '#' })),
];
const categoryProps = {
	label: 'Writing',
	kicker: 'Category',
	description: CATEGORY_BLURBS.writing,
	count: posts.length,
	siblings,
	posts: current.items,
	page: { current: current.current, total: current.total, base },
};
const title = design ? `${DESIGNS[design].group}: ${DESIGNS[design].name}` : 'Design lab';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} — Lab`} description="Layout experiments (local only)." noindex />
	</head>
	<body>
		<!-- Lab switcher -->
		<div class="sticky top-0 z-50 flex flex-wrap items-center gap-x-4 gap-y-1 bg-brand-gold px-4 py-2 text-[12px] font-semibold text-black">
			<a href="/lab/" class="!text-black no-underline">LAB</a>
			{
				(Object.keys(DESIGNS) as Design[]).map((d) => (
					<a href={`/lab/${d}/`} class:list={['!text-black', d === design ? 'underline' : 'no-underline opacity-70 hover:opacity-100']}>
						{DESIGNS[d].name.toUpperCase()}
					</a>
				))
			}
			<span class="ml-auto flex items-center gap-3">
				{design && <span class="opacity-80">{DESIGNS[design].note}</span>}
				<!-- Testing helpers: fill or empty this browser's saved posts -->
				<button type="button" data-lab-saves="fill" class="border border-black/40 px-2 py-0.5 hover:bg-black hover:text-brand-gold">Add sample saves</button>
				<button type="button" data-lab-saves="clear" class="border border-black/40 px-2 py-0.5 hover:bg-black hover:text-brand-gold">Clear saves</button>
			</span>
		</div>

		<Header sections={SAMPLE_SECTIONS} sectionsVariant="auto" sectionsSaved savedHref="/lab/saved/" />

		{
			!design && (
				<main class="page-narrow py-14">
					<h1 class="font-display !text-[48px] font-semibold uppercase">Design lab</h1>
					<p class="text-muted-foreground">
						Real posts plus {posts.length - (await getCollection('blog')).length} made-up samples, so each layout has enough to show. Only on your computer.
					</p>
					{['Navbar', 'Pages'].map((g) => (
						<section class="mt-10">
							<h2 class="label !mb-4 !text-[13px] text-primary">{g}</h2>
							<ul class="!m-0 border border-border !p-0" role="list">
								{(Object.keys(DESIGNS) as Design[])
									.filter((d) => DESIGNS[d].group === g)
									.map((d) => (
										<li class="list-none border-b border-border last:border-b-0">
											<a href={`/lab/${d}/`} class="flex items-baseline justify-between gap-4 p-5 !text-foreground no-underline hover:bg-muted">
												<span class="font-display text-[22px] font-semibold uppercase">{DESIGNS[d].name}</span>
												<span class="text-[14px] text-muted-foreground">{DESIGNS[d].note}</span>
											</a>
										</li>
									))}
							</ul>
						</section>
					))}
				</main>
			)
		}

		{design === 'nav-combo' && <SectionFront {...categoryProps} />}

		{design === 'saved' && <SavedList />}

		<script>
			// Lab helpers: add every real post to this browser's saved list, or empty it
			document.querySelectorAll<HTMLButtonElement>('[data-lab-saves]').forEach((b) =>
				b.addEventListener('click', async () => {
					const all =
						b.dataset.labSaves === 'fill'
							? ((await (await fetch('/search.json')).json()) as { url: string }[]).map((e) => e.url.replace(/^\/blog\/|\/$/g, ''))
							: [];
					localStorage.setItem('savedPosts', JSON.stringify(all));
					window.dispatchEvent(new CustomEvent('post-reactions-change'));
				}),
			);
		</script>

		<Footer />
	</body>
</html>
