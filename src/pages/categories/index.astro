---
// All categories (/categories/): big title, then one row per section with its description,
// post count and newest post. Biggest sections first.
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostImage from '../../components/PostImage.astro';
import TermHeader from '../../components/taxonomy/TermHeader.astro';
import { SITE_TITLE } from '../../consts';
import { categoryBlurb } from '../../lib/siteConfig';
import { formatDate, sortByDate } from '../../lib/posts';
import { abs, breadcrumbs } from '../../lib/seo';
import { MIN_POSTS_TO_INDEX, categoryIndex } from '../../lib/taxonomy';

const categories = categoryIndex(await getCollection('blog'));
const blurbs = Object.fromEntries(await Promise.all(categories.map(async (c) => [c.slug, await categoryBlurb(c.slug)] as const)));
const indexable = categories.some((c) => c.posts.length >= MIN_POSTS_TO_INDEX);
const schema = [
	{ '@type': 'CollectionPage', name: 'Categories', url: abs('/categories/'), isPartOf: { '@id': abs('/#website') } },
	breadcrumbs([{ name: 'Categories', path: '/categories/' }]),
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Categories — ${SITE_TITLE}`}
			description="Browse Joel Green's writing by section: writing, craft, worldbuilding, news and more."
			noindex={!indexable}
			schema={schema}
		/>
	</head>
	<body>
		<Header />
		<TermHeader
			label="Categories"
			kicker="Browse by section"
			description="The sections of The Creative Panel. Each one collects every post written for it."
			count={categories.length}
			meta={`${categories.length} ${categories.length === 1 ? 'section' : 'sections'}`}
			siblings={[
				{ label: 'Categories', href: '/categories/', current: true },
				{ label: 'Tags', href: '/tags/' },
				{ label: 'Archive', href: '/blog/' },
			]}
		/>
		<main class="page-wide py-12">
			{
				categories.length > 0 ? (
					<ul class="!m-0 border-t border-border !p-0" role="list">
						{categories.map((c) => {
							const latest = sortByDate(c.posts)[0];
							return (
								<li class="list-none border-b border-border">
									<div class="grid items-center gap-6 py-8 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
										<a href={`/categories/${c.slug}/`} class="group block !text-foreground no-underline">
											<p class="label !mb-2 !text-[16px] text-muted-foreground">
												{c.posts.length} {c.posts.length === 1 ? 'post' : 'posts'}
											</p>
											<h2 class="!mb-2 font-display !text-[44px] font-bold uppercase !leading-[0.9] tracking-[-1px] transition-colors group-hover:text-primary md:!text-[56px]">
												{c.label}
												<span class="text-brand-logo-accent">.</span>
											</h2>
											{blurbs[c.slug] && <p class="!m-0 max-w-md text-[16px] text-muted-foreground">{blurbs[c.slug]}</p>}
										</a>
										{latest && (
											<a href={`/blog/${latest.id}/`} class="group flex items-center gap-4 !text-foreground no-underline md:justify-self-end">
												<div class="aspect-[4/3] w-28 shrink-0 overflow-hidden bg-muted">
													<PostImage fallback={latest.data.category ?? ''} src={latest.data.heroImage} alt="" width={300} class="h-full w-full !rounded-none object-cover" />
												</div>
												<div class="min-w-0 max-w-xs">
													<p class="label !mb-1 !text-[16px] text-primary">Latest · {formatDate(latest.data.pubDate)}</p>
													<p class="!m-0 font-display text-[20px] font-semibold uppercase leading-tight transition-colors group-hover:text-primary">{latest.data.title}</p>
												</div>
											</a>
										)}
									</div>
								</li>
							);
						})}
					</ul>
				) : (
					<p class="text-[16px] text-muted-foreground">No categories yet.</p>
				)
			}
		</main>
		<Footer />
	</body>
</html>
