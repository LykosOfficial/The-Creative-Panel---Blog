---
// All categories (/categories/), biggest first, with how many posts each has.
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import LightPageHeader from '../../components/LightPageHeader.astro';
import { SITE_TITLE } from '../../consts';
import { abs, breadcrumbs } from '../../lib/seo';
import { MIN_POSTS_TO_INDEX, categoryIndex } from '../../lib/taxonomy';

const categories = categoryIndex(await getCollection('blog'));
// Worth indexing once at least one category page is (otherwise it's a list of thin pages)
const indexable = categories.some((t) => t.posts.length >= MIN_POSTS_TO_INDEX);
const schema = [
	{ '@type': 'CollectionPage', name: 'Categories', url: abs('/categories/'), isPartOf: { '@id': abs('/#website') } },
	breadcrumbs([{ name: 'Categories', path: '/categories/' }]),
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Categories — ${SITE_TITLE}`}
			description="Browse Joel Green's writing by section: writing, craft, worldbuilding, news and more."
			noindex={!indexable}
			schema={schema}
		/>
	</head>
	<body>
		<Header />

		<LightPageHeader label="Browse" title="Categories" width="narrow" />

		<main class="categories-page page-narrow">
			{
				categories.length > 0 ? (
					<ul class="!m-0 grid gap-px border border-border bg-border !p-0 sm:grid-cols-2" role="list">
						{categories.map((t) => (
							<li class="list-none bg-background">
								<a href={`/categories/${t.slug}/`} class="group flex items-center justify-between gap-4 p-4 !text-foreground no-underline transition-colors hover:bg-muted sm:p-5">
									<span class="font-display text-[17px] font-semibold uppercase tracking-[-0.1px] transition-colors group-hover:text-primary">{t.label}</span>
									<span class="shrink-0 text-[12px] uppercase tracking-[0.08em] text-muted-foreground">
										{t.posts.length} {t.posts.length === 1 ? 'post' : 'posts'}
									</span>
								</a>
							</li>
						))}
					</ul>
				) : (
					<p class="text-[15px] text-muted-foreground">No categories yet.</p>
				)
			}
		</main>

		<Footer />

		<style>
			main.categories-page {
				width: 100%;
				padding-top: 2.5rem;
				padding-bottom: 4rem;
			}
		</style>
	</body>
</html>
