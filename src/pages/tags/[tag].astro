---
// One page per tag (/tags/the-halo/): every post with that tag, newest first.
// Pages with fewer than MIN_POSTS_TO_INDEX posts stay out of Google until they fill up.
import { getCollection } from 'astro:content';
import ArchiveRow from '../../components/ArchiveRow.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import LightPageHeader from '../../components/LightPageHeader.astro';
import { SITE_TITLE } from '../../consts';
import { sortByDate } from '../../lib/posts';
import { abs, breadcrumbs } from '../../lib/seo';
import { MIN_POSTS_TO_INDEX, tagIndex, type Term } from '../../lib/taxonomy';

export async function getStaticPaths() {
	const tags = tagIndex(await getCollection('blog'));
	return tags.map((tag) => ({ params: { tag: tag.slug }, props: { tag, others: tags.filter((t) => t.slug !== tag.slug).slice(0, 12) } }));
}

interface Props {
	tag: Term;
	others: Term[];
}
const { tag, others } = Astro.props;
const posts = sortByDate(tag.posts);
const noun = posts.length === 1 ? 'post' : 'posts';
const path = `/tags/${tag.slug}/`;
const schema = [
	{
		'@type': 'CollectionPage',
		name: `${tag.label}`,
		url: abs(path),
		isPartOf: { '@id': abs('/#website') },
		mainEntity: {
			'@type': 'ItemList',
			itemListElement: posts.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(`/blog/${p.id}/`), name: p.data.title })),
		},
	},
	breadcrumbs([
		{ name: 'Tags', path: '/tags/' },
		{ name: tag.label, path },
	]),
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${tag.label} — ${SITE_TITLE}`}
			description={`${posts.length} ${noun} by Joel Green tagged “${tag.label}” on The Creative Panel: essays, chapters and writing notes, newest first.`}
			noindex={posts.length < MIN_POSTS_TO_INDEX}
			schema={schema}
		/>
	</head>
	<body>
		<Header />

		<LightPageHeader label="Tag" title={tag.label} width="narrow" />

		<main class="tag-page page-narrow">
			<p class="!mb-3 text-[12px] uppercase tracking-[0.1em] text-muted-foreground">
				{posts.length} {noun} · <a href="/tags/" class="!text-muted-foreground underline hover:!text-primary">All tags</a>
			</p>

			<ul class="!m-0 border border-border !p-0" role="list">
				{posts.map((post) => <ArchiveRow post={post} />)}
			</ul>

			{
				others.length > 0 && (
					<nav aria-label="More tags" class="mt-10">
						<p class="label !mb-3 !text-[12px] text-muted-foreground">More tags</p>
						<div class="flex flex-wrap gap-1.5">
							{others.map((t) => (
								<a href={`/tags/${t.slug}/`} class="tag-chip">
									#{t.label}
								</a>
							))}
						</div>
					</nav>
				)
			}
		</main>

		<Footer />

		<style>
			main.tag-page {
				width: 100%;
				padding-top: 2.5rem;
				padding-bottom: 4rem;
			}
		</style>
	</body>
</html>
