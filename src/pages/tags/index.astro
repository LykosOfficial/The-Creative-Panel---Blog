---
// All tags (/tags/): big title, then every tag as a word with its post count in a bubble.
// Sort tabs switch between A–Z, Z–A, most posts and fewest posts.
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import TagsCloud from '../../components/taxonomy/TagsCloud.astro';
import TermHeader from '../../components/taxonomy/TermHeader.astro';
import { SITE_TITLE } from '../../consts';
import { abs, breadcrumbs } from '../../lib/seo';
import { MIN_POSTS_TO_INDEX, tagIndex } from '../../lib/taxonomy';

const tags = tagIndex(await getCollection('blog'));
// Worth indexing once at least one tag page is (otherwise it's a list of thin pages)
const indexable = tags.some((t) => t.posts.length >= MIN_POSTS_TO_INDEX);
const schema = [
	{ '@type': 'CollectionPage', name: 'Tags', url: abs('/tags/'), isPartOf: { '@id': abs('/#website') } },
	breadcrumbs([{ name: 'Tags', path: '/tags/' }]),
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Tags — ${SITE_TITLE}`}
			description="Browse Joel Green's writing by topic: The Halo, worldbuilding, the writing life and more."
			noindex={!indexable}
			schema={schema}
		/>
	</head>
	<body>
		<Header />
		<TermHeader
			label="Tags"
			kicker="Browse by topic"
			description="Every topic on The Creative Panel. Pick one to read everything filed under it."
			count={tags.length}
			meta={`${tags.length} ${tags.length === 1 ? 'tag' : 'tags'}`}
			siblings={[
				{ label: 'Tags', href: '/tags/', current: true },
				{ label: 'Categories', href: '/categories/' },
				{ label: 'Archive', href: '/blog/' },
			]}
		/>
		<main class="page-wide py-12">
			{tags.length > 0 ? <TagsCloud terms={tags} base="/tags/" prefix="#" /> : <p class="text-[15px] text-muted-foreground">No tags yet.</p>}
		</main>
		<Footer />
	</body>
</html>
