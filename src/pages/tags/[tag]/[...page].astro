---
// /tags/<slug>/ and /tags/<slug>/page/2/ …: every post with a tag, 12 a page.
// The chips under the title are the tags most often used alongside this one.
import { getCollection } from 'astro:content';
import TermPage from '../../../components/taxonomy/TermPage.astro';
import { paginate } from '../../../lib/pagination';
import { sortByDate } from '../../../lib/posts';
import { relatedTags, tagIndex } from '../../../lib/taxonomy';

export async function getStaticPaths() {
	const tags = tagIndex(await getCollection('blog'));
	return tags.flatMap((term) =>
		paginate(sortByDate(term.posts), `/tags/${term.slug}/`).map((page) => ({
			params: { tag: term.slug, page: page.current === 1 ? undefined : `page/${page.current}` },
			props: {
				term,
				page,
				siblings: [
					{ label: `#${term.label}`, href: `/tags/${term.slug}/`, current: true },
					...relatedTags(term, tags).map((t) => ({ label: `#${t.label}`, href: `/tags/${t.slug}/` })),
					{ label: 'All tags →', href: '/tags/' },
				],
			},
		})),
	);
}

const { term, page, siblings } = Astro.props;
---

<TermPage kind="tag" term={term} page={page} siblings={siblings} />
