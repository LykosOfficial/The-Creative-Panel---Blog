---
// Shown for any URL that doesn't exist (Cloudflare serves dist/404.html). Not indexed.
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import LightPageHeader from '../components/LightPageHeader.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Page not found — ${SITE_TITLE}`} description="This page doesn't exist or has moved." noindex />
	</head>
	<body>
		<Header />
		<LightPageHeader label="Error 404" title="Page not found" width="narrow" />
		<main class="page-narrow pb-24 pt-10">
			<p class="!mb-8 max-w-xl text-[17px] leading-relaxed text-muted-foreground">
				This page doesn't exist, or it has moved. Try the latest writing, or browse everything in the archive.
			</p>
			<div class="flex flex-wrap gap-3">
				<a href="/" class="label bg-primary px-6 py-3 !text-[12px] !font-semibold !text-primary-foreground no-underline hover:opacity-90">Latest writing</a>
				<a href="/blog/" class="label border border-border px-6 py-3 !text-[12px] !font-semibold !text-foreground no-underline hover:border-primary">Archive</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
