---
// The Archive (prototype "All posts"): every post, newest first, with a live search box.
import PostImage from '../../components/PostImage.astro';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import LightPageHeader from '../../components/LightPageHeader.astro';
import { SITE_TITLE } from '../../consts';
import { abs, breadcrumbs } from '../../lib/seo';
import { formatDate, sortByDate } from '../../lib/posts';

const posts = sortByDate(await getCollection('blog'));
const schema = [
	{
		'@type': 'CollectionPage',
		name: 'Archive',
		url: abs('/blog/'),
		isPartOf: { '@id': abs('/#website') },
		mainEntity: {
			'@type': 'ItemList',
			itemListElement: posts.slice(0, 30).map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(`/blog/${p.id}/`), name: p.data.title })),
		},
	},
	breadcrumbs([{ name: 'Archive', path: '/blog/' }]),
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Archive — ${SITE_TITLE}`}
			description="Every essay, chapter and writing note by Joel Green, newest first: sci-fi worldbuilding, the craft of fiction and the making of The Halo."
			schema={schema}
		/>
	</head>
	<body>
		<Header />

		<LightPageHeader label="Archive" title="All Posts" width="narrow" />

		<main class="archive page-narrow">
			<!-- Search: filters the list below as you type -->
			<label class="relative mb-6 block">
				<span class="sr-only">Search posts</span>
				<svg class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
					><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg
				>
				<input
					type="search"
					data-archive-search
					placeholder="Search by title, tag, or excerpt..."
					autocomplete="off"
					class="h-11 w-full border border-border bg-card pl-10 pr-4 text-[14px] outline-none placeholder:text-muted-foreground focus:border-primary"
				/>
			</label>

			<p class="!mb-3 text-[12px] uppercase tracking-[0.1em] text-muted-foreground" role="status">
				<span data-archive-count>{posts.length}</span> <span data-archive-noun>{posts.length === 1 ? 'post' : 'posts'}</span> found
			</p>

			<ul class="!m-0 border border-border !p-0" role="list">
				{
					posts.map((post) => (
						<li
							class="archive-row list-none border-b border-border last:border-b-0"
							data-search={`${post.data.title} ${post.data.description} ${post.data.category} ${post.data.tags.join(' ')}`.toLowerCase()}
						>
							<a href={`/blog/${post.id}/`} class="group flex items-center gap-5 p-4 !text-foreground no-underline transition-colors hover:bg-muted sm:p-5">
								{post.data.heroImage && (
									<PostImage
										src={post.data.heroImage}
										alt=""
										width={300}
										class="h-[72px] w-24 shrink-0 !rounded-none object-cover grayscale transition duration-300 group-hover:grayscale-0 sm:h-24 sm:w-32"
									/>
								)}
								<div class="min-w-0 flex-1">
									<p class="!mb-1 font-display text-[11px] font-bold uppercase tracking-[0.1em] text-primary [word-spacing:0.35em]">
										{post.data.tags.slice(0, 3).map((t) => `#${t}`).join(' ')}
									</p>
									<h2 class="!mb-1.5 font-display !text-[18px] font-semibold uppercase !leading-tight tracking-[-0.1px] transition-colors group-hover:text-primary sm:!text-[19px]">
										{post.data.title}
									</h2>
									<p class="!mb-1.5 hidden text-[13px] leading-relaxed text-muted-foreground sm:block">{post.data.description}</p>
									<p class="!m-0 text-[12px] uppercase tracking-[0.08em] text-muted-foreground/80">{formatDate(post.data.pubDate)}</p>
								</div>
								<svg class="hidden h-5 w-5 shrink-0 text-muted-foreground transition group-hover:translate-x-0.5 group-hover:text-primary sm:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
									<path d="M5 12h14M13 6l6 6-6 6" />
								</svg>
							</a>
						</li>
					))
				}
			</ul>
			<p class="archive-empty !mt-6 hidden text-[15px] text-muted-foreground">No posts match that search.</p>
			{
				posts.length === 0 && (
					<p class="!mt-6 text-[15px] leading-relaxed text-muted-foreground">
						No posts yet. The first essays and chapters are on their way; subscribe to the newsletter below to get them first.
					</p>
				)
			}
		</main>

		<Footer />

		<script>
			// Live search: hide rows that don't contain every word typed
			const input = document.querySelector<HTMLInputElement>('[data-archive-search]');
			const rows = document.querySelectorAll<HTMLElement>('.archive-row');
			const count = document.querySelector('[data-archive-count]')!;
			const noun = document.querySelector('[data-archive-noun]')!;
			const empty = document.querySelector<HTMLElement>('.archive-empty')!;
			const list = rows[0]?.parentElement;

			input?.addEventListener('input', () => {
				const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
				let shown = 0;
				rows.forEach((row) => {
					const match = terms.every((t) => row.dataset.search!.includes(t));
					row.hidden = !match;
					if (match) shown++;
				});
				count.textContent = String(shown);
				noun.textContent = shown === 1 ? 'post' : 'posts';
				empty.classList.toggle('hidden', shown > 0);
				list?.classList.toggle('hidden', shown === 0);
			});
		</script>

		<style>
			/* Same width + side padding as the homepage grid */
			.page-inner {
				max-width: 77rem;
				padding-inline: 1rem;
			}
			@media (min-width: 640px) {
				.page-inner {
					padding-inline: 1.5rem;
				}
			}
			@media (min-width: 1024px) {
				.page-inner {
					padding-inline: 2.25rem;
				}
			}
			main.archive {
				width: 100%;
				padding-top: 2.5rem;
				padding-bottom: 4rem;
			}
			/* last visible row shouldn't keep a bottom border inside the box */
			.archive-row:not([hidden]):last-of-type {
				border-bottom: 0;
			}
		</style>
	</body>
</html>
