# Used by production builds (astro build / pnpm deploy:blog). Not secret.
# Posts, books and sites are loaded from the live API at build time.
PUBLIC_API_URL=https://api.joelgreen.studio

# Google AdSense publisher ID (public). Drives /ads.txt and the AdSense loader script.
# Ad unit IDs for each ad space are below.
PUBLIC_ADSENSE_CLIENT=ca-pub-9503690846112991
# Ad unit IDs (data-ad-slot) from AdSense → Ads → By ad unit. Responsive display units.
PUBLIC_ADSENSE_SLOT_HOME_SIDEBAR=7897044495
PUBLIC_ADSENSE_SLOT_POST_SIDEBAR=5566394625
# In-article units: mid-post (phones/tablets) and end of post (all screens)
PUBLIC_ADSENSE_SLOT_IN_ARTICLE=9451020509
PUBLIC_ADSENSE_SLOT_POST_END=8892617304

# Google Tag Manager container (public). Loads in <head> on every page (BaseHead.astro).
PUBLIC_GTM_ID=GTM-N8BKT96D
